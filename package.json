{
  "name": "gidieats-backend",
  "version": "1.0.0",
  "description": "REST API for GidiEats Kano - BUK Campus Food Delivery System (Final Year Project for Fatima Adam Aminu - Bayero University Kano)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:create": "sequelize-cli db:create",
    "db:drop": "sequelize-cli db:drop",
    "seed": "tsx src/seeders/seed-all.ts",
    "seed:drinks": "tsx src/seeders/run-drinks-seed.ts",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && tsx src/seeders/seed-all.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:images": "tsx src/utils/generate-images.ts"
  },
  "keywords": ["food-delivery", "restaurant", "ecommerce", "api", "express", "sequelize"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}