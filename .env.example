# Server
PORT=5001
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gidieats
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql
DB_LOGGING=false

# CORS origins (comma separated)
CLIENT_URL=http://localhost:5173

# Flutterwave Payment Gateway (Test / Live)
FLW_PUBLIC_KEY=FLWPUBK_TEST-SANDBOXDEMOKEY-X
FLW_SECRET_KEY=FLWSECK_TEST-SANDBOXDEMOKEY-X
FLW_ENCRYPTION_KEY=FLWSECK_TEST_ENCRYPT-X
FLW_SECRET_HASH=gidieats_flw_secret_hash

# Seed password for demo accounts
SEED_PASSWORD=Demo@123

# Uploads
UPLOAD_DIR=uploads