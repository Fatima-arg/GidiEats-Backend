# DB_SSL=true
#
# OR provide single DATABASE_URL connection string:
# DATABASE_URL=mysql://avnadmin:your_password@mysql-1d8e26db-fatimaaminu528-9722.b.aivencloud.com:16605/defaultdb?ssl-mode=REQUIRED

# Allowed Frontend Origins for CORS (comma-separated if multiple, e.g. http://localhost:5173,https://your-frontend.vercel.app)
CLIENT_URL=http://localhost:5173

# Flutterwave Payment Gateway (Test / Live)
FLW_PUBLIC_KEY=FLWPUBK_TEST-SANDBOXDEMOKEY-X
FLW_SECRET_KEY=FLWSECK_TEST-SANDBOXDEMOKEY-X
FLW_ENCRYPTION_KEY=FLWSECK_TEST_ENCRYPT-X
FLW_SECRET_HASH=gidieats_flw_secret_hash

SEED_PASSWORD=Demo@123
UPLOAD_DIR=uploads
