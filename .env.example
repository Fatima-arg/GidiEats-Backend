# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=5001
NODE_ENV=production

JWT_SECRET=super_secret_gidieats_jwt_key_2024_change_me
JWT_EXPIRES_IN=7d

# ==============================================================================
# LOCAL DATABASE CONFIGURATION (Default for local development)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gidieats
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql
DB_LOGGING=false
DB_SSL=false

# ==============================================================================
# ONLINE CLOUD DATABASE (Render / Aiven Cloud MySQL)
# In your Render service dashboard (Environment tab), set these variables:
# ==============================================================================
# DB_HOST=mysql-1d8e26db-fatimaaminu528-9722.b.aivencloud.com
# DB_PORT=16605
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_password_here
